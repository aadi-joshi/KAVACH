# KAVACH — environment variables
#
# Copy to .env.local and fill in. Everything is optional: with no key the app
# runs fully, and briefings use the deterministic template (the console says
# so on screen). These are read on the server only and never sent to the
# browser.

# Nugen Intelligence API key (https://docs.nugen.in). Enables aligned-model
# phrasing of briefings and supervisor Q&A, held to the plan by the fact-lock.
NUGEN_API_KEY=

# Id of your deployed aligned model, e.g. model_01kmqm4nrn9fw6r
# (GET /api/v3/models/aligned, deployment_status "DEPLOYED").
# If left empty, the first DEPLOYED aligned model on the account is used.
NUGEN_MODEL=

# OpenAI-compatible inference base URL. /chat/completions is appended.
# Default: https://api.nugen.in/api/v3/inference
NUGEN_BASE_URL=

# Optional: per-request budget in milliseconds before falling back to the
# template. Default 8000.
# NUGEN_TIMEOUT_MS=8000
